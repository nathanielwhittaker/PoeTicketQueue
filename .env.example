# Copy to .env and fill in. .env is gitignored.

# Published image to run (from the Release workflow). Rarely needs changing.
APP_IMAGE=ghcr.io/nathanielwhittaker/poeticketqueue

# Release to deploy. Pin to a tag (e.g. v0.1.0 -> 0.1.0) for reproducible deploys,
# or use 'latest' to always take the newest release.
APP_VERSION=latest

# Cloudflare Tunnel connector token. Only needed for the 'tunnel' profile.
# Zero Trust dashboard > Networks > Tunnels > (your tunnel) > Install connector —
# copy the token from the `--token` value in the shown command.
TUNNEL_TOKEN=
